# Solo variables PUBLICAS del front (todo lo que empieza con VITE_ se ve en el navegador).
# NUNCA pongas aquí claves de Brevo, Gemini, JWT ni MongoDB: eso vive solo en el backend.
VITE_API_URL=http://localhost:3000/graphql
# true = usuarios de demostración sin backend | false = usa el API real (GraphQL)
VITE_USE_MOCK=true
VITE_SESSION_INACTIVITY_MINUTES=30
